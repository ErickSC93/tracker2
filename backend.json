{
  "entities": {
    "Equipment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Equipment",
      "type": "object",
      "description": "Represents a piece of equipment undergoing calibration.",
      "properties": {
        "internalId": { "type": "string", "description": "Unique identifier generated by the client." },
        "companyName": { "type": "string" },
        "manufacturer": { "type": "string" },
        "equipmentId": { "type": "string" },
        "model": { "type": "string" },
        "serialNumber": { "type": "string" },
        "description": { "type": "string" },
        "receptionDate": { "type": "string", "format": "date-time" },
        "technician": { "type": "string" },
        "observations": { "type": "string" },
        "status": { "type": "string", "enum": ["received", "processing", "calibrated", "delivered"] },
        "calibratedBy": { "type": ["string", "null"] },
        "deliveredBy": { "type": ["string", "null"] },
        "deliveryDate": { "type": ["string", "null"], "format": "date-time" },
        "labelPlaced": { "type": "boolean" }
      },
      "required": [ "internalId", "companyName", "equipmentId", "model", "serialNumber", "receptionDate", "technician", "status" ]
    },
    "Lists": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "title": "Lists",
        "type": "object",
        "description": "A singleton document to store various dynamic lists for the application.",
        "properties": {
            "personnel": { "type": "array", "items": { "type": "string" } },
            "clients": { "type": "array", "items": { "type": "string" } },
            "manufacturers": { "type": "array", "items": { "type": "string" } },
            "models": { "type": "array", "items": { "type": "string" } },
            "descriptions": { "type": "array", "items": { "type": "string" } }
        }
    }
  },
  "auth": {
    "providers": [ "anonymous" ]
  },
  "firestore": {
    "/equipments/{equipmentId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "Stores all equipment documents."
    },
    "/lists/{listId}": {
      "schema": { "$ref": "#/entities/Lists" },
      "description": "Stores a single document with id 'singleton' containing all dynamic lists for the app."
    }
  }
}
